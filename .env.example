VITE_MOCK_MODE=true
VITE_API_URL=http://localhost:3000/api/chat
# 서버 전용. VITE_ 접두사를 붙이지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 투자위원회 의장: 평소 Terra, 충돌/급변/월간 보고서에는 Sol 자동 승격
USE_LLM_CHAIR=1
CHAIR_OPENAI_MODEL=gpt-5.6-terra
CHAIR_REASONING_EFFORT=medium
CHAIR_ESCALATION_MODEL=gpt-5.6-sol
CHAIR_ESCALATION_REASONING_EFFORT=medium
CHAIR_FORCE_SOL=0
CHAIR_URGENT_FLAG=0
CHAIR_REPORT_MODE=daily
