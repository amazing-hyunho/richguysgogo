    "stage_order": [
      "research_validation",
      "talent_mobility",
      "capital_formation",
      "infrastructure_bottleneck",
      "earnings_confirmation"
    ],
    "stage_weights": {
      "research_validation": 0.25,
      "talent_mobility": 0.15,
      "capital_formation": 0.2,
      "infrastructure_bottleneck": 0.2,
      "earnings_confirmation": 0.2
    },
    "stage_score_threshold": 60.0,
    "stage_confidence_threshold": 50.0,
    "source_reliability": {
      "academic_primary": 1.0,
      "academic_preprint": 0.75,
      "regulatory_filing": 1.0,
      "company_filing": 0.95,
      "company_release": 0.82,
      "reputable_media": 0.72,
      "secondary_analysis": 0.55,
      "other": 0.4
    },
    "lookahead_rule": "Include evidence only when known_at <= as_of.",
    "score_formula": "mean(direction * strength * source_reliability) * 100, floored at 0",
